---
import { getDictionary, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const localeLabels: Record<Locale, string> = {
  ca: "CA",
  es: "ES",
  en: "EN",
};

const otherLocales = (["ca", "es", "en"] as Locale[]).filter((l) => l !== locale);
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center py-4">
      <a href={locale === 'ca' ? '/' : `/${locale}/`} class="flex items-center gap-3 group">
        <div class="relative">
          <img src="/images/logo.png" alt={t.site.name} class="h-14 w-auto transition-transform duration-300 group-hover:scale-105" />
        </div>
        <div class="hidden sm:block">
          <h1 class="text-lg font-heading font-bold text-dark tracking-tight">{t.site.name}</h1>
          <p class="text-xs font-accent text-muted uppercase tracking-widest">{t.site.tagline}</p>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        <a href="#about" class="px-4 py-2 text-sm font-medium text-dark hover:text-primary transition-colors rounded-lg hover:bg-primary/5">
          {t.nav.about}
        </a>
        <a href="#sponsors" class="px-4 py-2 text-sm font-medium text-dark hover:text-primary transition-colors rounded-lg hover:bg-primary/5">
          {t.nav.sponsors}
        </a>
        <a href="#contact" class="px-4 py-2 text-sm font-medium text-dark hover:text-primary transition-colors rounded-lg hover:bg-primary/5">
          {t.nav.contact}
        </a>
        <a href="https://www.instagram.com/chmatadejonc/" target="_blank" rel="noopener noreferrer" class="ml-2 px-4 py-2 text-sm font-medium bg-primary-dark text-white rounded-lg hover:brightness-110 transition-colors">
          {t.nav.instagram}
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-1">
          {otherLocales.map((loc) => (
            <a
              href={loc === 'ca' ? '/' : `/${loc}/`}
              class="px-3 py-1 text-xs font-accent font-bold text-muted hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 transition-colors rounded-md hover:bg-white"
            >
              {localeLabels[loc]}
            </a>
          ))}
        </div>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden relative w-10 h-10 flex items-center justify-center rounded-lg text-dark hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 transition-colors"
          aria-label="Obrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-5 h-5 hamburger-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-5 h-5 hamburger-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-gray-100 bg-white/95 backdrop-blur-md"
    role="menu"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 space-y-1">
      <a href="#about" class="block px-4 py-3 text-sm font-medium text-dark hover:text-primary hover:bg-primary/5 rounded-lg transition-colors" role="menuitem">
        {t.nav.about}
      </a>
      <a href="#sponsors" class="block px-4 py-3 text-sm font-medium text-dark hover:text-primary hover:bg-primary/5 rounded-lg transition-colors" role="menuitem">
        {t.nav.sponsors}
      </a>
      <a href="#contact" class="block px-4 py-3 text-sm font-medium text-dark hover:text-primary hover:bg-primary/5 rounded-lg transition-colors" role="menuitem">
        {t.nav.contact}
      </a>
      <a href="https://www.instagram.com/chmatadejonc/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-3 text-sm font-medium bg-primary-dark text-white rounded-lg hover:brightness-110 transition-colors" role="menuitem">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        {t.nav.instagram}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.querySelector('.hamburger-open')?.classList.toggle('hidden', isOpen);
      toggle.querySelector('.hamburger-close')?.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-label', isOpen ? 'Tancar menú' : 'Obrir menú');
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.querySelector('.hamburger-open')?.classList.remove('hidden');
        toggle.querySelector('.hamburger-close')?.classList.add('hidden');
        toggle.setAttribute('aria-label', 'Obrir menú');
      });
    });
  }
</script>
