---
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const sponsors = [
  { name: 'Patrocinador 1', logo: '/images/sponsor1.png' },
  { name: 'Patrocinador 2', logo: '/images/sponsor2.png' },
  { name: 'Patrocinador 3', logo: '/images/sponsor3.png' },
];

const collaborators = [
  { name: 'Col·laborador 1', logo: '/images/collaborator1.png' },
  { name: 'Col·laborador 2', logo: '/images/collaborator2.png' },
];
---

<section id="sponsors" class="py-32 bg-light relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 animate-fade-up">
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-dark mb-4">
        {t.sponsors.title}
      </h2>
      <p class="text-lg text-muted max-w-2xl mx-auto">
        Gràcies als nostres patrocinadors i col·laboradors per fer possible el nostre projecte.
      </p>
    </div>
    
    <!-- Sponsors -->
    <div class="mb-20">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {sponsors.map((sponsor, index) => (
          <div 
            class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-center h-40 transition-all duration-300 hover:shadow-lg hover:scale-105 hover:border-primary/20 animate-fade-up"
            style={`animation-delay: ${index * 0.1}s`}
          >
            <img src={sponsor.logo} alt={sponsor.name} class="max-h-20 max-w-full object-contain opacity-80 hover:opacity-100 transition-opacity" />
          </div>
        ))}
      </div>
    </div>
    
    <!-- Collaborators -->
    <div>
      <div class="grid grid-cols-2 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {collaborators.map((collaborator, index) => (
          <div 
            class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-center h-40 transition-all duration-300 hover:shadow-lg hover:scale-105 hover:border-primary/20 animate-fade-up"
            style={`animation-delay: ${0.3 + index * 0.1}s`}
          >
            <img src={collaborator.logo} alt={collaborator.name} class="max-h-20 max-w-full object-contain opacity-80 hover:opacity-100 transition-opacity" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
