---
import { getDictionary, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<form
  id="contact-form"
  class="space-y-6"
  action="https://formsubmit.co/handbolmatadejonc@gmail.com"
  method="POST"
>
  <!-- FormSubmit configuration -->
  <input type="hidden" name="_subject" value={t.contactForm.subjectHidden} />
  <input type="hidden" name="_captcha" value="true" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_next" value={Astro.url.href} />
  <input type="text" name="_honey" value="" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid grid-cols-2 gap-6">
    <div>
      <label for="name" class="block text-sm font-accent font-bold text-dark mb-2 uppercase tracking-wider">
        {t.contactForm.name.label}
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        minlength="2"
        class="w-full px-4 py-3 bg-light border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 focus:border-transparent transition-all duration-300 text-dark placeholder-gray-400"
        placeholder={t.contactForm.name.placeholder}
      />
    </div>

    <div>
      <label for="email" class="block text-sm font-accent font-bold text-dark mb-2 uppercase tracking-wider">
        {t.contactForm.email.label}
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-3 bg-light border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 focus:border-transparent transition-all duration-300 text-dark placeholder-gray-400"
        placeholder={t.contactForm.email.placeholder}
      />
    </div>
  </div>

  <div>
    <label for="subject" class="block text-sm font-accent font-bold text-dark mb-2 uppercase tracking-wider">
      {t.contactForm.subject.label}
    </label>
    <input
      type="text"
      id="subject"
      name="subject"
      required
      minlength="2"
      class="w-full px-4 py-3 bg-light border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 focus:border-transparent transition-all duration-300 text-dark placeholder-gray-400"
      placeholder={t.contactForm.subject.placeholder}
    />
  </div>

  <div>
    <label for="message" class="block text-sm font-accent font-bold text-dark mb-2 uppercase tracking-wider">
      {t.contactForm.message.label}
    </label>
    <textarea
      id="message"
      name="message"
      required
      minlength="10"
      rows="5"
      class="w-full px-4 py-3 bg-light border border-gray-200 rounded-xl focus:ring-2 focus:ring-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 focus:border-transparent transition-all duration-300 text-dark placeholder-gray-400 resize-none"
      placeholder={t.contactForm.message.placeholder}
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full bg-primary-dark text-white px-8 py-4 rounded-xl font-semibold text-lg hover:brightness-110 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 transition-all duration-300 hover:shadow-lg hover:shadow-primary/30 flex items-center justify-center gap-2"
  >
    {t.contactForm.submit}
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
    </svg>
  </button>
</form>
