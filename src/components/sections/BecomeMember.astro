---
import { getDictionary, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const benefits = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: t.becomeMember.benefits.training.title,
    description: t.becomeMember.benefits.training.description,
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    title: t.becomeMember.benefits.community.title,
    description: t.becomeMember.benefits.community.description,
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: t.becomeMember.benefits.values.title,
    description: t.becomeMember.benefits.values.description,
  },
];
---

<section class="py-32 bg-dark relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-primary/20 via-transparent to-primary/10"></div>
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary/30 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-primary/20 rounded-full blur-3xl"></div>
  </div>
  
  <!-- Grid pattern -->
  <div class="absolute inset-0 z-[1] opacity-5" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="animate-fade-up">
        <h2 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6 leading-tight">
          {t.becomeMember.title}
        </h2>
        
        <p class="text-lg text-white/70 leading-relaxed mb-10">
          {t.becomeMember.subtitle}
        </p>
        
        <div class="space-y-6 mb-10">
          {benefits.map((benefit) => (
            <div class="flex items-start gap-4">
              <span class="text-primary mt-1 flex-shrink-0" set:html={benefit.icon} />
              <div>
                <h3 class="text-white font-semibold mb-1">{benefit.title}</h3>
                <p class="text-white/60 text-sm">{benefit.description}</p>
              </div>
            </div>
          ))}
        </div>
        
        <a
          href="#contact"
          class="group inline-flex items-center gap-3 bg-primary-dark text-white px-8 py-4 rounded-xl font-semibold text-lg hover:brightness-110 transition-all duration-300 hover:shadow-lg hover:shadow-primary/30"
        >
          {t.contact.title}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
      
      <div class="animate-fade-up stagger-2">
        <div class="bg-white/5 rounded-3xl border border-white/10 p-8 backdrop-blur-sm">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <span class="text-primary text-2xl font-heading font-bold">+20</span>
              <span class="text-white/70">anys formant esportistes</span>
            </div>
            <div class="w-full h-px bg-white/10"></div>
            <div class="flex items-center gap-4">
              <span class="text-primary text-2xl font-heading font-bold">100+</span>
              <span class="text-white/70">esportistes actius</span>
            </div>
            <div class="w-full h-px bg-white/10"></div>
            <div class="flex items-center gap-4">
              <span class="text-primary text-2xl font-heading font-bold">50+</span>
              <span class="text-white/70">equips en competició</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
