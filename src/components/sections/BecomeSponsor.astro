---
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="py-32 bg-dark relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-primary/20 via-transparent to-primary/10"></div>
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary/30 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-primary/20 rounded-full blur-3xl"></div>
  </div>
  
  <!-- Grid pattern -->
  <div class="absolute inset-0 z-[1] opacity-5" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="animate-fade-up">
        <span class="inline-block px-4 py-1 bg-white/10 text-white text-sm font-accent font-bold uppercase tracking-wider rounded-full mb-6 border border-white/20">
          Patrocini
        </span>
        
        <h2 class="text-4xl md:text-5xl font-heading font-bold text-white mb-8 leading-tight">
          {t.becomeSponsor.title}
        </h2>
        
        <p class="text-lg text-gray-400 leading-relaxed mb-10">
          {t.becomeSponsor.description}
        </p>
        
        <a
          href="#contact"
          class="group inline-flex items-center gap-3 bg-primary text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-primary-dark transition-all duration-300 hover:shadow-lg hover:shadow-primary/30"
        >
          {t.contact.title}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
      
      <div class="grid grid-cols-2 gap-4 animate-fade-up stagger-2">
        <div class="p-6 bg-white/5 rounded-2xl border border-white/10 backdrop-blur-sm">
          <div class="text-4xl font-heading font-bold text-primary mb-2">+20</div>
          <div class="text-sm text-gray-400">Anyos d'història</div>
        </div>
        <div class="p-6 bg-white/5 rounded-2xl border border-white/10 backdrop-blur-sm">
          <div class="text-4xl font-heading font-bold text-primary mb-2">100+</div>
          <div class="text-sm text-gray-400">Esportistes</div>
        </div>
        <div class="p-6 bg-white/5 rounded-2xl border border-white/10 backdrop-blur-sm">
          <div class="text-4xl font-heading font-bold text-primary mb-2">50+</div>
          <div class="text-sm text-gray-400">Equips</div>
        </div>
        <div class="p-6 bg-white/5 rounded-2xl border border-white/10 backdrop-blur-sm">
          <div class="text-4xl font-heading font-bold text-primary mb-2">∞</div>
          <div class="text-sm text-gray-400">Passió</div>
        </div>
      </div>
    </div>
  </div>
</section>
