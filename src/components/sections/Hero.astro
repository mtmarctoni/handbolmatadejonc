---
import { getDictionary, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-dark">
  <!-- Background image with parallax -->
  <div 
    class="absolute inset-0 z-0"
    style="background-image: url('/images/hero.jpg'); background-size: cover; background-position: center; background-attachment: fixed;"
  >
    <div class="absolute inset-0 bg-dark/50"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-dark/30"></div>
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32">
    <div class="max-w-3xl">
      <div class="animate-fade-up">
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-heading font-bold text-white mb-6 leading-[0.95]">
          <span class="block">Club</span>
          <span class="block text-primary">Handbol</span>
          <span class="block">Mata de Jonc</span>
        </h1>
        
        <p class="text-lg md:text-xl text-white/70 mb-10 max-w-lg leading-relaxed">
          {t.hero.intro}
        </p>
        
        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="group inline-flex items-center gap-3 bg-primary-dark text-white px-8 py-4 rounded-xl font-semibold text-lg hover:brightness-110 transition-all duration-300 hover:shadow-lg hover:shadow-primary/30"
          >
            {t.hero.cta}
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="#about"
            class="inline-flex items-center gap-3 bg-white/10 text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-white/20 transition-all duration-300 backdrop-blur-sm border border-white/10"
          >
            {t.nav.about}
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-float">
    <div class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center pt-2">
      <div class="w-1 h-3 bg-white/50 rounded-full"></div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    section > div:first-child {
      background-attachment: scroll !important;
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    section > div:first-child {
      background-attachment: scroll !important;
    }
  }
</style>
