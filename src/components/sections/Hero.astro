---
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="relative bg-gradient-to-br from-primary to-dark text-white py-20 md:py-32 overflow-hidden">
  <!-- Background image with overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero.jpg"
      alt=""
      class="w-full h-full object-cover opacity-20"
    />
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl md:text-6xl font-heading font-bold mb-6">
      {t.site.name}
    </h1>
    <p class="text-xl md:text-2xl text-gray-200 mb-8">
      {t.site.tagline}
    </p>
    <a
      href="#contact"
      class="inline-block bg-secondary text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-green-700 transition-colors"
    >
      {t.contact.title}
    </a>
  </div>
</section>
