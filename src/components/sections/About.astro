---
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const values = [
  { 
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    title: 'Formació', 
    description: 'Personal i esportiva' 
  },
  { 
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: 'Esfors', 
    description: 'Cultura de l\'esforç' 
  },
  { 
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'Valors', 
    description: 'Humans de l\'esport' 
  },
  { 
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`,
    title: 'Èxits', 
    description: 'Resultat del treball' 
  },
];
---

<section id="about" class="py-32 bg-white relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-primary/5 to-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="animate-fade-up">
        <h2 class="text-4xl md:text-5xl font-heading font-bold text-dark mb-8 leading-tight">
          {t.about.title}
        </h2>
        
        <div class="space-y-6 text-lg text-muted leading-relaxed">
          <p>{t.about.history}</p>
        </div>
        
        <div class="mt-10">
          <a href="#contact" class="inline-flex items-center gap-2 text-primary font-semibold hover:gap-4 transition-all duration-300">
            Uneix-te a nosaltres
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
      
      <div class="grid grid-cols-2 gap-4 animate-fade-up stagger-2">
        {values.map((value, index) => (
          <div class={`p-6 rounded-2xl ${index % 2 === 0 ? 'bg-primary/5' : 'bg-dark'} transition-all duration-300 hover:scale-105`}>
            <span class={`mb-4 block ${index % 2 === 0 ? 'text-primary' : 'text-primary'}`} set:html={value.icon} />
            <h3 class={`font-heading font-bold text-lg mb-1 ${index % 2 === 0 ? 'text-dark' : 'text-white'}`}>
              {value.title}
            </h3>
            <p class={`text-sm ${index % 2 === 0 ? 'text-muted' : 'text-gray-400'}`}>
              {value.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
