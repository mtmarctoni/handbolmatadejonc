---
import { getDictionary, type Locale } from "../../i18n";
import ContactForm from "./ContactForm.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section id="contact" class="py-32 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 animate-fade-up">
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-dark mb-4">
        {t.contact.title}
      </h2>
      <p class="text-lg text-muted max-w-2xl mx-auto">
        {t.contact.intro}
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-16">
      <!-- Contact Info -->
      <div class="space-y-8 animate-fade-up">
        <div class="p-8 bg-light rounded-2xl border border-gray-100">
          <h3 class="font-heading font-bold text-xl text-dark mb-6 flex items-center gap-3">
            <span class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </span>
            {t.contact.addressLabel}
          </h3>
          <p class="text-muted leading-relaxed">{t.contact.address}</p>
        </div>
        
        <div class="p-8 bg-light rounded-2xl border border-gray-100">
          <h3 class="font-heading font-bold text-xl text-dark mb-6 flex items-center gap-3">
            <span class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </span>
            {t.contact.emailLabel}
          </h3>
          <a href={`mailto:${t.contact.email}`} class="text-primary-dark font-semibold hover:text-primary transition-colors">
            {t.contact.email}
          </a>
        </div>
        
        <div class="p-8 bg-light rounded-2xl border border-gray-100">
          <h3 class="font-heading font-bold text-xl text-dark mb-6 flex items-center gap-3">
            <span class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </span>
            {t.contact.phoneLabel}
          </h3>
          <a href={`tel:+34${t.contact.phone.replace(/\s/g, '')}`} class="text-primary-dark font-semibold hover:text-primary transition-colors">
            {t.contact.phone}
          </a>
        </div>
      </div>
      
      <!-- Contact Form -->
      <div class="animate-fade-up stagger-2">
        <ContactForm locale={locale} />
      </div>
    </div>
  </div>
</section>
