---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import About from "../components/sections/About.astro";
import BecomeMember from "../components/sections/BecomeMember.astro";
import Contact from "../components/sections/Contact.astro";
import Gallery from "../components/sections/Gallery.astro";
import Hero from "../components/sections/Hero.astro";
import Sponsors from "../components/sections/Sponsors.astro";
import Teams from "../components/sections/Teams.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout locale="ca" title="Inici">
  <Header locale="ca" />
  
  <main id="main-content">
    <Hero locale="ca" />
    <About locale="ca" />
    <Gallery locale="ca" />
    <Teams locale="ca" />
