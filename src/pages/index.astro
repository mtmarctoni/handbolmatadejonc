---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Gallery from '../components/sections/Gallery.astro';
import Teams from '../components/sections/Teams.astro';
import BecomeMember from '../components/sections/BecomeMember.astro';
import Sponsors from '../components/sections/Sponsors.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout locale="ca" title="Inici">
  <Header locale="ca" />
  
  <main>
    <Hero locale="ca" />
    <About locale="ca" />
    <Gallery locale="ca" />
    <Teams locale="ca" />
    <BecomeMember locale="ca" />
    <Sponsors locale="ca" />
    <Contact locale="ca" />
  </main>

  <Footer locale="ca" />
</BaseLayout>
