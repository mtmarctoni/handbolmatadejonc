---
import SEO from "../components/SEO.astro";
import { getDictionary, type Locale } from "../i18n";
import "../styles/global.css";

interface Props {
  locale: string;
  title?: string;
  description?: string;
}

const { locale, title = "Inici", description } = Astro.props;
const t = getDictionary(locale as Locale);
const seoDescription = description ?? `${t.site.name} - ${t.site.tagline}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <SEO title={title} description={seoDescription} locale={locale} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Outfit:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-light text-dark font-body">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-primary-dark focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold"
    >
      {t.a11y.skipToContent}
    </a>
    <slot />
  </body>
</html>
